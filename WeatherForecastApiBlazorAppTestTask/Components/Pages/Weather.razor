@page "/weather"
@rendermode InteractiveServer
@attribute [StreamRendering]
@inject IMediator Mediator

@using MediatR;
@using WeatherForecastApi.Application.Models
@using WeatherForecastApi.Application.Queries
@using WeatherForecastApi.Application.Exceptions
@using WeatherForecastApiBlazorAppTestTask.Components.Partial

<PageTitle>Погода</PageTitle>

<Settings />

@if (isLoading)
{
	<Loader />
}
else if (errorMessage is not null)
{
	<ErrorLoad ErrorMessage="errorMessage" OnRetry="LoadWeatherAsync" />
}
else if (weather is not null)
{
	var current = weather.Current;
	var hours = weather.Hourly;
	var days = weather.Daily;

	<div class="row">
		<!-- Левая колонка: текущая погода -->
		<CurrentWeather Current="current" />

		<!-- Правая колонка: вкладки с прогнозами -->
		<div class="col-md-6">
			<!-- Вкладки Bootstrap -->
			<ul class="nav nav-tabs mb-3" id="weatherTabs" role="tablist">
				<li class="nav-item" role="presentation">
					<button class="nav-link active" id="hourly-btn" data-bs-toggle="tab"
							data-bs-target="#hourly-tab" type="button" role="tab">
						Почасовой прогноз
					</button>
				</li>
				<li class="nav-item" role="presentation">
					<button class="nav-link" id="daily-btn" data-bs-toggle="tab"
							data-bs-target="#daily-tab" type="button" role="tab">
						Ежедневный прогноз
					</button>
				</li>
			</ul>

			<div class="tab-content">
				<!-- Почасовой прогноз -->
				<div class="tab-pane fade show active" id="hourly-tab" role="tabpanel">
					<HourlyForecast Hours="hours" />
				</div>

				<!-- Ежедневный прогноз -->
				<div class="tab-pane fade" id="daily-tab" role="tabpanel">
					<DailyForecast Days="days" />
				</div>
			</div>
		</div>
	</div>
}

@code {
	private bool isLoading = true;
	private string? errorMessage;
	private WeatherQueryResult? weather;
	private bool useCelsius = true;
	private bool useKph = true;

	protected override async Task OnInitializedAsync()
	{
		await LoadWeatherAsync();
	}

	private async Task LoadWeatherAsync()
	{
		isLoading = true;
		errorMessage = null;
		weather = null;

		try
		{
			//await Task.Delay(500);
			weather = await Mediator.Send(new GetWeatherQuery());
		}
		catch (ApplicationConfigurationException)
		{
			errorMessage = "Ошибка конфигурации запроса";
		}
		catch (ApplicationWeatherAPIException)
		{
			errorMessage = "Ошибка получения данных о погоде";
		}
		catch (ApplicationUnknownException)
		{
			errorMessage = "Произошла неизвестная ошибка";
		}
		catch (Exception)
		{
			errorMessage = "Произошла неизвестная ошибка";
		}
		finally
		{
			isLoading = false;
		}
	}
}