@using WeatherForecastApi.Application.Models;

<div class="card">
	<div class="card-body">
		<div class="row g-2">
			@foreach (var daily in Days)
			{
				<div class="col-12 mb-2">
					<div class="d-flex justify-content-between align-items-center p-2 border rounded">
						<!-- Левая часть: дата и иконка состояния -->
						<div>
							<strong>@daily.Date</strong><br>
							<img src="@daily.ConditionIcon" alt="@daily.ConditionText" width="25" height="25">
						</div>

						<!-- Центральная часть: температуры (макс./мин.) -->
						<div class="text-center flex-grow-1 mx-3">
							<span class="daily-max-temp">
								@FormatTemp(daily.MaxTempC, daily.MaxTempF)
							</span>
							/
							<span class="daily-min-temp">
								@FormatTemp(daily.MinTempC, daily.MinTempF)
							</span>
						</div>

						<!-- Правая часть: ветер и вероятность осадков -->
						<div class="text-end">
							<small>
								Ветер:
								<span class="daily-wind-speed">
									@FormatSpeed(daily.MaxWindKph, daily.MaxWindMph)
								</span>
							</small><br>
							<small>Дождь: @daily.DailyChanceOfRainPercent%</small>
						</div>
					</div>
				</div>
			}
		</div>
	</div>
</div>

@code {
	[Parameter, EditorRequired]
	public List<DailyWeatherQueryResult> Days { get; set; } = new();

	[Parameter]
	public bool UseCelsius { get; set; } = true;

	[Parameter]
	public bool UseKph { get; set; } = true;

	private string FormatTemp(decimal celsius, decimal fahrenheit)
		=> UseCelsius ? $"{celsius:0.#}°C" : $"{fahrenheit:0.#}°F";

	private string FormatSpeed(decimal kph, decimal mph)
		=> UseKph ? $"{kph:0.#} км/ч" : $"{mph:0.#} mph";
}
